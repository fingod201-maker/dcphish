[Unit]
Description=dcphish device-code token poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/dcphish
ExecStart=/opt/dcphish/.venv/bin/python /opt/dcphish/poll.py
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
